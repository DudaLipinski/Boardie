model FriendshipRequest {
  @@map("friendship_request")

  requestingUserId  Int
  requestingUser    User  @relation("sentFriendshipRequests", fields: [requestingUserId], references: [id], onDelete: Cascade)
  requestedUserId   Int
  requestedUser     User  @relation("receivedFriendshipRequests", fields: [requestedUserId], references: [id], onDelete: Cascade)

  @@id([requestingUserId, requestedUserId])
}