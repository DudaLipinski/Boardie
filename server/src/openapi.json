{
  "openapi": "3.0.1",
  "info": {
    "version": "1.0.0",
    "title": "Boardie",
    "description": "API to serve the Boardie application"
  },
  "paths": {
    "/me": {
      "post": {
        "summary": "Creates a new user",
        "tags": [
          "auth"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "firstName": {
                    "type": "string"
                  },
                  "middleAndSurname": {
                    "type": "string"
                  },
                  "age": {
                    "type": "number",
                    "minimum": 1,
                    "maximum": 120,
                    "nullable": true
                  },
                  "email": {
                    "type": "string"
                  },
                  "password": {
                    "type": "string"
                  }
                },
                "required": [
                  "firstName",
                  "middleAndSurname",
                  "age",
                  "email",
                  "password"
                ],
                "additionalProperties": false,
                "description": "Data used to create a new user"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The created user",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "number"
                    },
                    "firstName": {
                      "type": "string"
                    },
                    "middleAndSurname": {
                      "type": "string"
                    },
                    "age": {
                      "type": "number",
                      "minimum": 1,
                      "maximum": 120,
                      "nullable": true
                    },
                    "email": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "id",
                    "firstName",
                    "middleAndSurname",
                    "age",
                    "email"
                  ],
                  "additionalProperties": false,
                  "description": "Data that represents a user"
                }
              }
            }
          },
          "400": {
            "description": "The request body is invalid"
          },
          "409": {
            "description": "There's already a user registered with this email"
          },
          "500": {
            "description": "An unexpected internal error"
          }
        }
      },
      "get": {
        "summary": "Gets the logged user",
        "tags": [
          "auth"
        ],
        "responses": {
          "200": {
            "description": "The logged user",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "number"
                    },
                    "firstName": {
                      "type": "string"
                    },
                    "middleAndSurname": {
                      "type": "string"
                    },
                    "age": {
                      "type": "number",
                      "minimum": 1,
                      "maximum": 120,
                      "nullable": true
                    },
                    "email": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "id",
                    "firstName",
                    "middleAndSurname",
                    "age",
                    "email"
                  ],
                  "additionalProperties": false,
                  "description": "Data that represents a user"
                }
              }
            }
          },
          "404": {
            "description": "The logged user was not found"
          },
          "500": {
            "description": "An unexpected internal error"
          }
        }
      }
    },
    "/me/unregister": {
      "post": {
        "summary": "Unregisters the logged user",
        "tags": [
          "auth"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string"
                  },
                  "password": {
                    "type": "string"
                  }
                },
                "required": [
                  "email",
                  "password"
                ],
                "additionalProperties": false,
                "description": "Auth information about a user"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The logged user was unregistered"
          },
          "400": {
            "description": "The request body is invalid"
          },
          "401": {
            "description": "Invalid credentials"
          },
          "500": {
            "description": "An unexpected internal error"
          }
        }
      }
    },
    "/auth": {
      "post": {
        "summary": "Authenticates a user",
        "tags": [
          "auth"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string"
                  },
                  "password": {
                    "type": "string"
                  }
                },
                "required": [
                  "email",
                  "password"
                ],
                "additionalProperties": false,
                "description": "Auth information about a user"
              }
            }
          }
        },
        "responses": {
          "200": {},
          "400": {
            "description": "The request body is invalid"
          },
          "401": {
            "description": "Provided credentials doesn't match any valid user"
          },
          "500": {
            "description": "An unexpected internal error"
          }
        }
      }
    },
    "/me/matches": {
      "post": {
        "summary": "Creates a match for the logged user",
        "tags": [
          "matches"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "boardgameName": {
                    "type": "string"
                  },
                  "location": {
                    "type": "string",
                    "nullable": true
                  },
                  "startedAt": {
                    "type": "string"
                  },
                  "endedAt": {
                    "type": "string",
                    "nullable": true
                  },
                  "notes": {
                    "type": "string",
                    "nullable": true
                  },
                  "players": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "friend": {
                          "type": "object",
                          "properties": {
                            "id": {
                              "type": "number"
                            },
                            "type": {
                              "type": "string",
                              "enum": [
                                "ANON_FRIEND",
                                "USER"
                              ]
                            }
                          },
                          "required": [
                            "id",
                            "type"
                          ],
                          "additionalProperties": false,
                          "description": "Generic friend identification data"
                        },
                        "score": {
                          "type": "number",
                          "nullable": true
                        },
                        "isWinner": {
                          "type": "boolean"
                        }
                      },
                      "required": [
                        "friend",
                        "score",
                        "isWinner"
                      ],
                      "additionalProperties": false
                    }
                  }
                },
                "required": [
                  "boardgameName",
                  "location",
                  "startedAt",
                  "endedAt",
                  "notes",
                  "players"
                ],
                "additionalProperties": false,
                "description": "Data used to create a match along with its initial players"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The created match",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "number"
                    },
                    "authorId": {
                      "type": "number",
                      "nullable": true
                    },
                    "boardgameName": {
                      "type": "string"
                    },
                    "location": {
                      "type": "string",
                      "nullable": true
                    },
                    "startedAt": {
                      "type": "string"
                    },
                    "endedAt": {
                      "type": "string",
                      "nullable": true
                    },
                    "createdAt": {
                      "type": "string"
                    },
                    "deletedAt": {
                      "type": "string",
                      "nullable": true
                    },
                    "notes": {
                      "type": "string",
                      "nullable": true
                    },
                    "players": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "number"
                          },
                          "friend": {
                            "type": "object",
                            "properties": {
                              "id": {
                                "type": "number"
                              },
                              "type": {
                                "type": "string",
                                "enum": [
                                  "ANON_FRIEND",
                                  "USER"
                                ]
                              },
                              "fullName": {
                                "type": "string"
                              }
                            },
                            "required": [
                              "id",
                              "type",
                              "fullName"
                            ],
                            "additionalProperties": false,
                            "description": "Generic friend"
                          },
                          "score": {
                            "type": "number",
                            "nullable": true
                          },
                          "isWinner": {
                            "type": "boolean"
                          }
                        },
                        "required": [
                          "id",
                          "friend",
                          "score",
                          "isWinner"
                        ],
                        "additionalProperties": false,
                        "description": "Data that represents an existent player"
                      }
                    }
                  },
                  "required": [
                    "id",
                    "authorId",
                    "boardgameName",
                    "location",
                    "startedAt",
                    "endedAt",
                    "createdAt",
                    "deletedAt",
                    "notes",
                    "players"
                  ],
                  "additionalProperties": false,
                  "description": "Match data with its players"
                }
              }
            }
          },
          "400": {
            "description": "The request body is invalid"
          },
          "403": {
            "description": "The logged user is not friends with one of the players"
          },
          "500": {
            "description": "An unexpected internal error"
          }
        }
      },
      "get": {
        "summary": "Gets all the matches for the logged user",
        "tags": [
          "matches"
        ],
        "responses": {
          "200": {
            "description": "The matches",
            "content": {
