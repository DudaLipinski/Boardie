{
  "name": "@boardie/server",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "run-server": "nodemon --watch \"src/**\" --ext \"ts,json\" --ignore \"src/**/*.spec.ts\" --exec \"vite-node src/index\"",
    "start": "pnpm generate_open_api_docs && pnpm init_db && pnpm generate_jwt_token && pnpm run-server",
    "generate_jwt_token": "vite-node scripts/generateJwtSecrets",
    "generate_open_api_docs": "vite-node src/scripts/generateOpenApiDocs",
    "init_db": "prisma migrate dev",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "update-bgs": "vite-node scripts/updateBgsFromJson",
    "pre-commit": "pnpm lint && pnpm typecheck"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@boardie/endpoints": "workspace:*",
    "better-sqlite3": "^11.8.1",
    "cors": "^2.8.5",
    "dayjs": "^1.11.13",
    "express": "^4.21.2",
    "express-ipfilter": "^1.3.2",
    "express-pino-logger": "^7.0.0",
    "fuzzysort": "^3.1.0",
    "jsonwebtoken": "^9.0.2",
    "kysely": "^0.27.6",
    "lodash.omit": "^4.5.0",
    "lodash.pick": "^4.4.0",
    "prisma-kysely": "^1.8.0",
    "swagger-ui-express": "^5.0.1",
    "vite-node": "^2.1.9",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@jest/globals": "^29.7.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/cors": "^2.8.17",
    "@types/express": "4.17.21",
    "@types/express-pino-logger": "^4.0.5",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/lodash.omit": "^4.5.9",
    "@types/lodash.pick": "^4.4.9",
    "@types/node": "^22.13.10",
    "@types/sqlite3": "^3.1.11",
    "@types/swagger-ui-express": "^4.1.8",
    "axios": "^1.8.2",
    "dotenv": "^16.4.7",
    "eslint": "^9.22.0",
    "eslint-plugin-import": "^2.31.0",
    "jest": "^29.7.0",
    "jest-dev-server": "^10.1.4",
    "lint-staged": "^13.3.0",
    "nodemon": "^3.1.9",
    "openapi-types": "^12.1.3",
    "prettier": "^3.5.3",
    "prettier-eslint": "^16.3.0",
    "prisma": "^5.22.0",
    "prisma-dbml-generator": "^0.12.0",
    "ts-jest": "^29.2.6",
    "ts-node": "^10.9.2",
    "typescript": "^4.9.5",
    "typescript-eslint": "^8.26.0",
    "zod-to-json-schema": "^3.24.3"
  },
  "exports": {
    ".": {
      "types": "./src/types/api.ts"
    }
  }
}
