                            },
                            "isWinner": {
                              "type": "boolean"
                            }
                          },
                          "required": [
                            "id",
                            "friend",
                            "score",
                            "isWinner"
                          ],
                          "additionalProperties": false,
                          "description": "Data that represents an existent player"
                        }
                      }
                    },
                    "required": [
                      "id",
                      "authorId",
                      "boardgameName",
                      "location",
                      "startedAt",
                      "endedAt",
                      "createdAt",
                      "deletedAt",
                      "notes",
                      "players"
                    ],
                    "additionalProperties": false,
                    "description": "Match data with its players"
