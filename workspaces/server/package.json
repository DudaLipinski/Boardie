{
  "name": "express-server-sqlite",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "run-server": "nodemon --watch \"src/**\" --ext \"ts,json\" --ignore \"src/**/*.spec.ts\" --exec \"vite-node src/index\"",
    "start": "yarn generate_open_api_docs && yarn init_db && yarn generate_jwt_token && yarn run-server",
    "generate_jwt_token": "vite-node scripts/generateJwtSecrets",
    "generate_open_api_docs": "vite-node src/scripts/generateOpenApiDocs",
    "init_db": "prisma migrate dev",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "update-bgs": "vite-node scripts/updateBgsFromJson"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "better-sqlite3": "^11.5.0",
    "cors": "^2.8.5",
    "dayjs": "^1.11.13",
    "express": "^4.21.1",
    "express-ipfilter": "^1.3.2",
    "express-pino-logger": "^7.0.0",
    "fuzzysort": "^3.1.0",
    "immer": "^10.1.1",
    "jsonwebtoken": "^9.0.2",
    "kysely": "^0.27.4",
    "lodash.omit": "^4.5.0",
    "lodash.pick": "^4.4.0",
    "prisma-kysely": "^1.8.0",
    "swagger-ui-express": "^5.0.1",
    "vite-node": "^2.1.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@types/better-sqlite3": "^7.6.11",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/express-pino-logger": "^4.0.5",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/lodash.omit": "^4.5.9",
    "@types/lodash.pick": "^4.4.9",
    "@types/node": "^22.9.0",
    "@types/sqlite3": "^3.1.11",
    "@types/swagger-ui-express": "^4.1.7",
    "@typescript-eslint/eslint-plugin": "^8.13.0",
    "@typescript-eslint/parser": "^8.13.0",
    "axios": "^1.7.7",
    "dotenv": "^16.4.5",
    "eslint": "^9.14.0",
    "eslint-plugin-import": "^2.31.0",
    "jest": "^29.7.0",
    "jest-dev-server": "^10.1.4",
    "nodemon": "^3.1.7",
    "openapi-types": "^12.1.3",
    "prettier": "^3.3.3",
    "prettier-eslint": "^16.3.0",
    "prisma": "^5.22.0",
    "prisma-dbml-generator": "^0.12.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^4.7.0",
    "yarn-upgrade-all": "^0.7.4",
    "zod-to-json-schema": "^3.23.5"
  }
}
