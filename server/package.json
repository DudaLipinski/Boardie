{
  "name": "express-server-sqlite",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "start": "pnpm generate_open_api_docs && pnpm init_db && pnpm generate_jwt_token && nodemon --esm --experimental-specifier-resolution=node src/index.ts",
    "generate_jwt_token": "ts-node --esm --experimental-specifier-resolution=node scripts/generateJwtSecrets",
    "generate_open_api_docs": "ts-node --esm --experimental-specifier-resolution=node src/scripts/generateOpenApiDocs",
    "init_db": "prisma migrate dev",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "update-bgs": "ts-node --esm --experimental-specifier-resolution=node scripts/updateBgsFromJson"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "better-sqlite3": "^8.2.0",
    "cors": "^2.8.5",
    "dayjs": "^1.11.10",
    "express": "^4.18.2",
    "express-ipfilter": "^1.3.1",
    "express-pino-logger": "^7.0.0",
    "fuzzysort": "^2.0.4",
    "immer": "^10.0.3",
    "jsonwebtoken": "^9.0.2",
    "kysely": "^0.26.3",
    "lodash.omit": "^4.5.0",
    "lodash.pick": "^4.4.0",
    "prisma-kysely": "^1.7.1",
    "swagger-ui-express": "^5.0.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@types/axios": "^0.14.0",
    "@types/better-sqlite3": "^7.6.5",
    "@types/cors": "^2.8.14",
    "@types/express": "^4.17.19",
    "@types/express-pino-logger": "^4.0.3",
    "@types/jest": "^29.5.5",
    "@types/jsonwebtoken": "^9.0.3",
    "@types/lodash.omit": "^4.5.7",
    "@types/lodash.pick": "^4.4.7",
    "@types/node": "^18.8.3",
    "@types/sqlite3": "^3.1.9",
    "@types/swagger-ui-express": "^4.1.4",
    "@typescript-eslint/eslint-plugin": "^6.7.5",
    "@typescript-eslint/parser": "^6.7.5",
    "axios": "^1.5.1",
    "dotenv": "^16.3.1",
    "eslint": "^8.51.0",
    "eslint-plugin-import": "^2.28.1",
    "jest": "^29.7.0",
    "jest-dev-server": "^9.0.1",
    "nodemon": "^3.0.1",
    "openapi-types": "^12.1.3",
    "prettier": "^3.0.3",
    "prettier-eslint": "^16.1.1",
    "prisma": "^5.4.2",
    "prisma-dbml-generator": "^0.10.0",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1",
    "typescript": "^4.8.4",
    "yarn-upgrade-all": "^0.7.2",
    "zod-to-json-schema": "^3.21.4"
  }
}
