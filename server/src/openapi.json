                                "fullName": {
                                  "type": "string"
                                }
                              },
                              "required": [
                                "id",
                                "type",
                                "fullName"
                              ],
                              "additionalProperties": false,
                              "description": "Generic friend"
                            },
                            "score": {
                              "type": "number",
